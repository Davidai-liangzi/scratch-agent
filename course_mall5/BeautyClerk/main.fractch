costume "Witch" file "assets/BeautyClerk.svg" center 74,59;
// BeautyClerk: host for beauty_1 (control flow generated by assembler)
// goal: Listen to the scent clerk label the sample bottles on the glass tray, then follow her to the styling table.
when broadcast scene_beauty_1 {
    done_beauty_1 = 0;
    hits_beauty_1 = 0;
    show;
    goto 0, 70;
    set_size 70;
    say "The clerk taps a bottle: every sample here is named for its scent, never for its colour." for 2.5;
    say "Rose, lemon and cedar sit on the tray — keep your eyes on the one I lift." for 2.5;
    done_beauty_1 = 1;
}

when flag {
    hide;
}
