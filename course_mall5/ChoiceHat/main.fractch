costume "Hat1" file "assets/ChoiceHat.svg" center 50,50;
// ChoiceHat: click target for beauty_2, control flow generated by assembler
when broadcast scene_beauty_2 {
    hide;
}

when broadcast scene_beauty_2_play {
    show;
    goto -140, 0;
    set_size 55;
}

when clicked {
    if done_beauty_2 == 0 {
        play_sound "Pop";
        hide;
        hits_beauty_2 += 1;
        if hits_beauty_2 >= 2 {
            done_beauty_2 = 1;
            play_sound "Cheer";
        }
    }
}

when flag {
    hide;
}
