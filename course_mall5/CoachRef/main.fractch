costume "Referee" file "assets/CoachRef.svg" center 44,63;
// CoachRef: host for sports_1 (control flow generated by assembler)
// goal: Hear the referee explain the warm-up drill (three passes, then shoot) before walking to the hoop court.
when broadcast scene_sports_1 {
    done_sports_1 = 0;
    hits_sports_1 = 0;
    show;
    goto 0, 70;
    set_size 70;
    say "The referee blows the whistle: on this field we warm up with three passes, then we shoot." for 2.5;
    say "Watch the ball bounce once for every pass, then follow me to the hoop." for 2.5;
    done_sports_1 = 1;
}

when flag {
    hide;
}
