costume "Referee" file "assets/DrillCoach.svg" center 44,63;
// DrillCoach: host for sports_2 (control flow generated by assembler)
// goal: Click the loose ball three times to score three baskets and get the tour card signed.
when broadcast scene_sports_2 {
    done_sports_2 = 0;
    hits_sports_2 = 0;
    show;
    goto 0, 70;
    set_size 70;
    say "The ball is loose on the court — every click sends it up at the hoop." for 2.5;
    say "Three clean shots and the coach signs your tour card." for 2.5;
    broadcast scene_sports_2_play;
}

when flag {
    hide;
}
