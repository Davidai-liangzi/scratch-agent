costume "Trampoline" file "assets/DrillTramp.png" center 400,164;
// DrillTramp: click target for sports_2, control flow generated by assembler
when broadcast scene_sports_2 {
    hide;
}

when broadcast scene_sports_2_play {
    show;
    goto 140, 0;
    set_size 55;
}

when clicked {
    if done_sports_2 == 0 {
        play_sound "Pop";
        hide;
        hits_sports_2 += 1;
        if hits_sports_2 >= 2 {
            done_sports_2 = 1;
            play_sound "Cheer";
        }
    }
}

when flag {
    hide;
}
