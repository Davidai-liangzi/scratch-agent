costume "Jamal" file "assets/EndingGuide.svg" center 55,49;
// EndingGuide: ending host (control flow generated by assembler)
when broadcast scene_ending {
    show;
    goto 0, -40;
    set_size 80;
    say "Back at the fountain: Captain Jamal reads out the route you walked and the tour points on your card." for 3;
    say "Take the gift bag — click the green flag and the mall will open again for a different route." for 3;
    broadcast game_end;
}

when flag {
    hide;
}
