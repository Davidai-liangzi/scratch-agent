costume "Kenney Chef" file "assets/FoodChef.png" center 48,48;
// FoodChef: host for food_1 (control flow generated by assembler)
// goal: Click the plate the chef calls out — the lunch special that came out of a shell.
when broadcast scene_food_1 {
    done_food_1 = 0;
    hits_food_1 = 0;
    show;
    goto 0, 70;
    set_size 70;
    say "Chef Kenney flips an omelette: the lunch special is the one that came out of a shell." for 2.5;
    say "Two plates are on the counter. Click the right one to get your tray stamped." for 2.5;
    broadcast scene_food_1_play;
}

when flag {
    hide;
}
