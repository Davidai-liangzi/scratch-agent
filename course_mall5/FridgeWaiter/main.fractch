costume "Kenney Waiter" file "assets/FridgeWaiter.png" center 48,48;
// FridgeWaiter: host for food_2 (control flow generated by assembler)
// goal: Press the space bar to reach the top shelf and pull out a cold drink from the walk-in fridge.
when broadcast scene_food_2 {
    done_food_2 = 0;
    hits_food_2 = 0;
    show;
    goto 0, 70;
    set_size 70;
    say "The waiter leads you into the cold room: the drinks are all the way up on the top shelf." for 2.5;
    say "Hold your breath and press the space bar to reach one." for 2.5;
}

// player presses space three times
when key space {
    if done_food_2 == 0 {
        play_sound "Pop";
        hits_food_2 += 1;
        if hits_food_2 >= 3 {
            done_food_2 = 1;
            play_sound "Cheer";
        }
    }
}

when flag {
    hide;
}
