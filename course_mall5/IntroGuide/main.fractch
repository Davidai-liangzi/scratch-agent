costume "Jamal" file "assets/IntroGuide.svg" center 55,49;
// IntroGuide: intro host (control flow generated by assembler)
when broadcast scene_intro {
    show;
    goto 0, -70;
    set_size 75;
    say "The Joy Plaza doors have just opened and the atrium fountain is still warming up." for 2.5;
    say "I am Captain Jamal, the mall guide. Click me and I will walk you over to the route board." for 2.5;
    broadcast scene_route_choice;
}

when flag {
    hide;
}
