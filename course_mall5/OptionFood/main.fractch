costume "Cake" file "assets/OptionFood.svg" center 64,50;
// OptionFood: option 2 (Food Court Lunch Run)
when broadcast scene_intro {
    hide;
}

when broadcast scene_route_choice {
    show;
    goto 0, 20;
    set_size 55;
    say "Food Court Lunch Run" for 1.5;
}

when clicked {
    if route == 0 {
        route = 2;
        play_sound "Pop";
        broadcast start_tour;
    }
}

when broadcast start_tour {
    hide;
}

when flag {
    hide;
}
