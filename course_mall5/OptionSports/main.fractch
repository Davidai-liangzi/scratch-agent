costume "Basketball" file "assets/OptionSports.svg" center 23,23;
// OptionSports: option 3 (Sports & Sneakers Court)
when broadcast scene_intro {
    hide;
}

when broadcast scene_route_choice {
    show;
    goto 140, 20;
    set_size 55;
    say "Sports & Sneakers Court" for 1.5;
}

when clicked {
    if route == 0 {
        route = 3;
        play_sound "Pop";
        broadcast start_tour;
    }
}

when broadcast start_tour {
    hide;
}

when flag {
    hide;
}
