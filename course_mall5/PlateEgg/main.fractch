costume "Egg" file "assets/PlateEgg.svg" center 18,26;
// PlateEgg: click target for food_1, control flow generated by assembler
when broadcast scene_food_1 {
    hide;
}

when broadcast scene_food_1_play {
    show;
    goto -140, 0;
    set_size 55;
}

when clicked {
    if done_food_1 == 0 {
        play_sound "Pop";
        hide;
        hits_food_1 += 1;
        if hits_food_1 >= 2 {
            done_food_1 = 1;
            play_sound "Cheer";
        }
    }
}

when flag {
    hide;
}
