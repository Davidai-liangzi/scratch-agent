costume "Witch" file "assets/StyleClerk.svg" center 74,59;
// StyleClerk: host for beauty_2 (control flow generated by assembler)
// goal: Click the piece that finishes the summer look the clerk described (the hat, not the scarf).
when broadcast scene_beauty_2 {
    done_beauty_2 = 0;
    hits_beauty_2 = 0;
    show;
    goto 0, 70;
    set_size 70;
    say "The clerk holds up a striped scarf: this only works with one thing on the table." for 2.5;
    say "Click the piece that turns it into a summer outfit." for 2.5;
    broadcast scene_beauty_2_play;
}

when flag {
    hide;
}
