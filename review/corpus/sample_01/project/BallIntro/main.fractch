costume "beachball" file "assets/beachball.svg" center 34,33;
// BallIntro: 右侧地板上的彩球上下漂浮暖场，一跳一个音符，撑起开场的背景音乐

use "music";

// 收到本幕广播：彩球从地板上飘起来再落回去，连跳 7 次后悄悄退场
when broadcast scene_intro {
    set_size 60;
    motion.setrotationstyle(STYLE: "all around");
    goto 115, -100;
    show;
    wait 0.4;
    repeat 7 {
        motion.glidesecstoxy(SECS: 0.5, X: 115, Y: -55);
        music.playNoteForBeats(NOTE: 60, BEATS: 0.25);
        motion.glidesecstoxy(SECS: 0.5, X: 115, Y: -100);
        music.playNoteForBeats(NOTE: 67, BEATS: 0.25);
        wait 0.2;
    }
    hide;
}

when flag {
    hide;
}
