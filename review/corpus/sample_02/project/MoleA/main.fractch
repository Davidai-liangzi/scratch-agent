costume "Mouse1" file "assets/Mouse1.svg" center 50,27;
sound "Pop" file "assets/Pop.wav";
// MoleA：左侧洞口的地鼠，冒头后 2 秒内被点中才加 1 分
var moleA_up = 0;   // 1 表示这只地鼠正露在洞口外面，可以被点中

// 本幕开始：在左侧洞口反复冒头、缩回，倒计时归零就收工
when broadcast scene_mini_game {
    set_size 55;
    goto -120, -70;
    hide;
    moleA_up = 0;
    while time_left > 0 {
        if random(1, 2) == 1 {
            wait 0.8;
        } else {
            wait 1.4;
        }
        show;
        moleA_up = 1;
        repeat 20 {
            if moleA_up == 1 {
                wait 0.1;
            }
        }
        hide;
        moleA_up = 0;
    }
    hide;
}

// 玩家点中冒头的这只地鼠：加 1 分、缩回洞里，缩回去以后再点就不算
when clicked {
    if moleA_up == 1 {
        score += 1;
        moleA_up = 0;
        play_sound "Pop";
        say "哎哟！被逮住了！" for 1;
    }
}

when flag {
    hide;
}
