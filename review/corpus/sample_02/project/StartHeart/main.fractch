costume "Heart" file "assets/Heart.svg" center 65,56;
sound "Pop" file "assets/Pop.wav";
// StartHeart：舞台中间偏右上下浮动的红心按钮，负责背景音乐，被点中后开始 30 秒挑战。

use "music";

var heart_on = 1;

// 收到开场广播：红心浮出来，一边上下跳动一边循环播放背景旋律
when broadcast scene_intro {
    heart_on = 1;
    set_size 55;
    goto 110, 10;
    show;
    until heart_on == 0 {
        change_y 8;
        music.playNoteForBeats(NOTE: 60, BEATS: 0.25);
        wait 0.3;
        change_y -8;
        music.playNoteForBeats(NOTE: 72, BEATS: 0.25);
        wait 0.3;
    }
}

// 爱心被点中：响一声，收起红心，最后一条语句广播进入打地鼠一幕
when clicked {
    if heart_on == 1 {
        heart_on = 0;
        play_sound "Pop";
        hide;
        broadcast scene_mini_game;
    }
}

when flag {
    hide;
}
