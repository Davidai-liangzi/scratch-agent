costume "Balloon1" file "assets/BeautyBalloon.svg" center 32,94;
// BeautyBalloon: host for beauty_game (control flow generated by assembler)
// goal: 30 秒内按空格抓住从试妆镜后飘出的气球，收满 3 个礼物
when broadcast scene_beauty_game {
    done_beauty_game = 0;
    hits_beauty_game = 0;
    show;
    goto 0, 70;
    set_size 70;
    say "气球从试妆镜后面飘出来了！" for 2.5;
    say "按空格抓住气球，收满 3 个礼物，别让它们飞出屋顶。" for 2.5;
}

// player presses space three times
when key space {
    if done_beauty_game == 0 {
        play_sound "Pop";
        hits_beauty_game += 1;
        if hits_beauty_game >= 3 {
            done_beauty_game = 1;
            play_sound "Cheer";
        }
    }
}

when flag {
    hide;
}
