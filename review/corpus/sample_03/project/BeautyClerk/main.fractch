costume "Kenney Shopkeeper" file "assets/BeautyClerk.png" center 48,48;
// BeautyClerk: host for beauty_end (control flow generated by assembler)
// goal: 在美妆区终点的丝巾柜台点击爱心，把镜子里的星星点出来
when broadcast scene_beauty_end {
    done_beauty_end = 0;
    hits_beauty_end = 0;
    show;
    goto 0, 70;
    set_size 70;
    say "欢迎来到美妆区的终点——丝巾柜台。" for 2.5;
    say "点一下柜台上的爱心，星星会从镜子里跳出来，一次只跳一颗。" for 2.5;
    broadcast scene_beauty_end_play;
}

when flag {
    hide;
}
