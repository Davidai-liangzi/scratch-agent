costume "Abby" file "assets/BeautyGuide.svg" center 31,100;
// BeautyGuide: host for beauty_entrance (control flow generated by assembler)
// goal: 在美妆区入口按空格点亮试妆镜，收齐 3 枚美妆徽章
when broadcast scene_beauty_entrance {
    done_beauty_entrance = 0;
    hits_beauty_entrance = 0;
    show;
    goto 0, 70;
    set_size 70;
    say "美妆区的入口立着一面试妆镜，灯泡还没亮。" for 2.5;
    say "按空格把灯打开，镜框上会蹦出三枚蝴蝶徽章，收齐了才放你进去。" for 2.5;
}

// player presses space three times
when key space {
    if done_beauty_entrance == 0 {
        play_sound "Pop";
        hits_beauty_entrance += 1;
        if hits_beauty_entrance >= 3 {
            done_beauty_entrance = 1;
            play_sound "Cheer";
        }
    }
}

when flag {
    hide;
}
