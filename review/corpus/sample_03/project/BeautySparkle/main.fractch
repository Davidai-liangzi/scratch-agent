costume "Heart" file "assets/BeautySparkle.svg" center 65,56;
// BeautySparkle: click target for beauty_end, control flow generated by assembler
when broadcast scene_beauty_end {
    hide;
}

when broadcast scene_beauty_end_play {
    show;
    goto 0, 0;
    set_size 55;
}

when clicked {
    if done_beauty_end == 0 {
        play_sound "Pop";
        hide;
        hits_beauty_end += 1;
        if hits_beauty_end >= 1 {
            done_beauty_end = 1;
            play_sound "Cheer";
        }
    }
}

when flag {
    hide;
}
