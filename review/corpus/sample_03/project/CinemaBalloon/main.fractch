costume "Balloon1" file "assets/CinemaBalloon.svg" center 32,94;
// CinemaBalloon: host for cinema_game (control flow generated by assembler)
// goal: 30 秒内按空格抓住飘过幕布的爆米花气球，收满 3 个礼物
when broadcast scene_cinema_game {
    done_cinema_game = 0;
    hits_cinema_game = 0;
    show;
    goto 0, 70;
    set_size 70;
    say "爆米花气球从放映机口飘了出来！" for 2.5;
    say "按空格抓住它们，收满 3 个礼物，散场灯就要亮了。" for 2.5;
}

// player presses space three times
when key space {
    if done_cinema_game == 0 {
        play_sound "Pop";
        hits_cinema_game += 1;
        if hits_cinema_game >= 3 {
            done_cinema_game = 1;
            play_sound "Cheer";
        }
    }
}

when flag {
    hide;
}
