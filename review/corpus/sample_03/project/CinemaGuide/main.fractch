costume "Kenney Teacher" file "assets/CinemaGuide.png" center 48,48;
// CinemaGuide: host for cinema_entrance (control flow generated by assembler)
// goal: 在电影院入口按空格掀开幕布，收齐 3 枚星星徽章
when broadcast scene_cinema_entrance {
    done_cinema_entrance = 0;
    hits_cinema_entrance = 0;
    show;
    goto 0, 70;
    set_size 70;
    say "电影院的门口挂着今晚的海报，幕布还拉着。" for 2.5;
    say "按空格掀开幕布，前排座椅会亮起三枚星星徽章。" for 2.5;
}

// player presses space three times
when key space {
    if done_cinema_entrance == 0 {
        play_sound "Pop";
        hits_cinema_entrance += 1;
        if hits_cinema_entrance >= 3 {
            done_cinema_entrance = 1;
            play_sound "Cheer";
        }
    }
}

when flag {
    hide;
}
