costume "Heart" file "assets/CinemaHeart.svg" center 65,56;
// CinemaHeart: click target for cinema_end, control flow generated by assembler
when broadcast scene_cinema_end {
    hide;
}

when broadcast scene_cinema_end_play {
    show;
    goto 0, 0;
    set_size 55;
}

when clicked {
    if done_cinema_end == 0 {
        play_sound "Pop";
        hide;
        hits_cinema_end += 1;
        if hits_cinema_end >= 1 {
            done_cinema_end = 1;
            play_sound "Cheer";
        }
    }
}

when flag {
    hide;
}
