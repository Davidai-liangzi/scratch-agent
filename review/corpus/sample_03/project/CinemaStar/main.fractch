costume "Ballerina" file "assets/CinemaStar.svg" center 31.00008984350052,49;
// CinemaStar: host for cinema_end (control flow generated by assembler)
// goal: 在影厅终点点击银幕上的爱心，让放映机撒出星星
when broadcast scene_cinema_end {
    done_cinema_end = 0;
    hits_cinema_end = 0;
    show;
    goto 0, 70;
    set_size 70;
    say "欢迎来到影厅终点，字幕刚滚完。" for 2.5;
    say "点一下银幕上的爱心，星星会从放映机口飞出来。" for 2.5;
    broadcast scene_cinema_end_play;
}

when flag {
    hide;
}
