costume "Balloon1" file "assets/FoodBalloon.svg" center 32,94;
// FoodBalloon: host for food_game (control flow generated by assembler)
// goal: 30 秒内按空格抓住厨房飘出的餐盘气球，收满 3 个礼物
when broadcast scene_food_game {
    done_food_game = 0;
    hits_food_game = 0;
    show;
    goto 0, 70;
    set_size 70;
    say "餐盘气球从厨房飘起来了！" for 2.5;
    say "按空格抓住它们，收满 3 个礼物，汤要凉了。" for 2.5;
}

// player presses space three times
when key space {
    if done_food_game == 0 {
        play_sound "Pop";
        hits_food_game += 1;
        if hits_food_game >= 3 {
            done_food_game = 1;
            play_sound "Cheer";
        }
    }
}

when flag {
    hide;
}
