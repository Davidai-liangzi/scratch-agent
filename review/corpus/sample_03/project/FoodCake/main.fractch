costume "Cake" file "assets/FoodCake.svg" center 64,50;
// FoodCake: click target for food_end, control flow generated by assembler
when broadcast scene_food_end {
    hide;
}

when broadcast scene_food_end_play {
    show;
    goto 0, 0;
    set_size 55;
}

when clicked {
    if done_food_end == 0 {
        play_sound "Pop";
        hide;
        hits_food_end += 1;
        if hits_food_end >= 1 {
            done_food_end = 1;
            play_sound "Cheer";
        }
    }
}

when flag {
    hide;
}
