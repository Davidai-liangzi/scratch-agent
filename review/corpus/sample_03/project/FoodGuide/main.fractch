costume "Kenney Chef" file "assets/FoodGuide.png" center 48,48;
// FoodGuide: host for food_entrance (control flow generated by assembler)
// goal: 在美食区入口按空格点燃大汤锅，收齐 3 枚橘子徽章
when broadcast scene_food_entrance {
    done_food_entrance = 0;
    hits_food_entrance = 0;
    show;
    goto 0, 70;
    set_size 70;
    say "美食区的入口是一口大汤锅，火还没点。" for 2.5;
    say "按空格开火，锅边会蹦出三枚橘子徽章，溅到地上可就不算数了。" for 2.5;
}

// player presses space three times
when key space {
    if done_food_entrance == 0 {
        play_sound "Pop";
        hits_food_entrance += 1;
        if hits_food_entrance >= 3 {
            done_food_entrance = 1;
            play_sound "Cheer";
        }
    }
}

when flag {
    hide;
}
