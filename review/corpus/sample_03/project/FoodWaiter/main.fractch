costume "Kenney Waiter" file "assets/FoodWaiter.png" center 48,48;
// FoodWaiter: host for food_end (control flow generated by assembler)
// goal: 在美食区终点的甜品台点击蛋糕，把奶油下的星星点出来
when broadcast scene_food_end {
    done_food_end = 0;
    hits_food_end = 0;
    show;
    goto 0, 70;
    set_size 70;
    say "欢迎来到美食区的终点——甜品台。" for 2.5;
    say "点一下这块蛋糕，看看奶油底下藏了几颗星星。" for 2.5;
    broadcast scene_food_end_play;
}

when flag {
    hide;
}
