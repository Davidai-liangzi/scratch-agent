costume "Kenney Guide" file "assets/GuideEnd.png" center 48,48;
// GuideEnd: ending host (control flow generated by assembler)
when broadcast scene_ending {
    show;
    goto 0, -40;
    set_size 80;
    say "回到广场啦，数一数你口袋里的星星——满 5 颗，这趟就没白走。" for 3;
    say "哪条街还想再逛一遍？点绿旗，换一块街牌重新出发。" for 3;
    broadcast game_end;
}

when flag {
    hide;
}
