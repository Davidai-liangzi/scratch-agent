costume "Kenney Guide" file "assets/GuideIntro.png" center 48,48;
// GuideIntro: intro host (control flow generated by assembler)
when broadcast scene_intro {
    show;
    goto 0, -70;
    set_size 75;
    say "梦想小镇今天开街，彩灯一路挂到广场的喷泉边。" for 2.5;
    say "我是你的伙伴 Hero，美妆区、美食区、电影院，先跟我认认这三块招牌。" for 2.5;
    broadcast scene_route_choice;
}

when flag {
    hide;
}
