costume "Dot" file "assets/MusicBox.svg" center 52,67;
// MusicBox: looping background music (control flow generated by assembler)
use "music";

when flag {
    hide;
    sound.setvolumeto(VOLUME: 55);
    forever {
        music.playNoteForBeats(NOTE: 60, BEATS: 0.5);
        music.playNoteForBeats(NOTE: 64, BEATS: 0.5);
        music.playNoteForBeats(NOTE: 67, BEATS: 0.5);
        music.playNoteForBeats(NOTE: 64, BEATS: 0.5);
        wait 0.5;
    }
}
