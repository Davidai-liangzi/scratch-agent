costume "Dress" file "assets/RouteBeauty.svg" center 57,83;
// RouteBeauty: option 1 (Beauty Street)
when broadcast scene_intro {
    hide;
}

when broadcast scene_route_choice {
    show;
    goto -140, 20;
    set_size 55;
    say "Beauty Street" for 1.5;
}

when clicked {
    if route == 0 {
        route = 1;
        play_sound "Pop";
        broadcast start_tour;
    }
}

when broadcast start_tour {
    hide;
}

when flag {
    hide;
}
