costume "Food Truck" file "assets/RouteFood.svg" center 120.82215422900005,123.2192;
// RouteFood: option 2 (Food Street)
when broadcast scene_intro {
    hide;
}

when broadcast scene_route_choice {
    show;
    goto 0, 20;
    set_size 55;
    say "Food Street" for 1.5;
}

when clicked {
    if route == 0 {
        route = 2;
        play_sound "Pop";
        broadcast start_tour;
    }
}

when broadcast start_tour {
    hide;
}

when flag {
    hide;
}
