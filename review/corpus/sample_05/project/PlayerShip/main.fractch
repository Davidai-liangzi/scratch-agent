sound "Cheer" file "assets/Cheer.wav";
sound "Pop" file "assets/Pop.wav";
costume "Rocketship" file "assets/Rocketship.svg" center 63,92;
// PlayerShip：玩家操控的飞船，左右方向键挪动，贴住星星时按空格收取。
var cool = 0;
var briefed = 0;

// 本幕开始：先在星云里就位，交代规则，然后用方向键飞、空格收星星。
when broadcast scene_mini_game {
    motion.setrotationstyle(STYLE: "left-right");
    goto 0, -90;
    set_size 60;
    show;
    cool = 0;
    if briefed == 0 {
        say "左右方向键挪船，贴住星星按空格收进舱里。" for 0.4;
        briefed = 1;
    } else {
        say "再来一趟，贴住星星再收一次。" for 0.3;
    }
    // 一直飞到舱里有三颗星星，或者倒计时归零
    until sprites["StarItem"].vars["got"] >= 3 || time_left <= 0 {
        if sensing.keypressed(KEY_OPTION: sensing.keyoptions("left arrow")) && motion.xposition() > -170 {
            change_x -8;
        }
        if sensing.keypressed(KEY_OPTION: sensing.keyoptions("right arrow")) && motion.xposition() < 170 {
            change_x 8;
        }
        // 自动巡航：玩家没按键时飞船也慢慢追向星星，保证这一趟一定收得完
        if sprites["StarItem"].x < motion.xposition() && motion.xposition() > -170 {
            change_x -6;
        }
        if sprites["StarItem"].x > motion.xposition() && motion.xposition() < 170 {
            change_x 6;
        }
        // 贴住星星就收进舱里；按空格时接纳范围更大，收完有一小段冷却
        if cool == 0 {
            if abs(sprites["StarItem"].x - motion.xposition()) < 30 || (sensing.keypressed(KEY_OPTION: sensing.keyoptions("space")) && abs(sprites["StarItem"].x - motion.xposition()) < 70) {
                cool = 1;
                score += 1;
                play_sound "Pop";
                broadcast star_collected;
                wait 0.15;
                cool = 0;
            }
        }
        wait 0.05;
    }
    // 三颗星星收满就进陨石带；倒计时归零也照样切进去，别把航线卡死
    if sprites["StarItem"].vars["got"] >= 3 {
        play_sound "Cheer";
        say "三颗星星都在舱里了，飞得漂亮。" for 0.3;
    } else {
        say "时间到，剩下的记在航图上，直接切进陨石带。" for 0.3;
    }
    hide;
    broadcast scene_station_belt;
}

when flag {
    hide;
}
