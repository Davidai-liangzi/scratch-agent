costume "Penguin" file "assets/penguin.svg" center 36,46;
// WinnerPenguin: Penguin stands on the podium only if it touched the finish heart first.

// On the ending scene: show on the podium when Penguin is the champion, otherwise stay hidden.
when broadcast scene_end {
    set_size 55;
    goto -95, -35;
    point 90;
    if winner == "Penguin" {
        show;
        repeat 4 {
            next_costume;
            wait 0.2;
        }
    } else {
        hide;
    }
}

when flag {
    hide;
}
