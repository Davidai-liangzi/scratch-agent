sound "Boing" file "assets/Boing.wav";
sound "Pop" file "assets/Pop.wav";
costume "cake-a" file "assets/cake-a.svg" center 64,50;
costume "cake-b" file "assets/cake-b.svg" center 64,42;
// CakeRain: drops cakes from the ceiling; every cake clone falls down and either feeds the basket (+1 score) or counts as a miss.

// when the play act starts: spawn the first cake quickly, then keep spawning clones until the round is over.
when broadcast scene_play {
    hide;
    wait 0.3;
    until playing == 0 {
        clone;
        wait 0.8;
    }
}

// for every cake clone: pick a costume, fall from the ceiling (often lined up above the basket), then score or count a miss.
when clone {
    show;
    if random(1, 2) == 1 {
        costume "cake-a";
    } else {
        costume "cake-b";
    }
    set_size 55;
    goto random(-160, 160), 140;
    if random(1, 3) != 1 {
        motion.glidesecstoxy(SECS: 0, X: sprites["Basket"].x, Y: 140);
    }
    until motion.yposition() < -95 || playing == 0 || sensing.touchingobject(TOUCHINGOBJECTMENU: "Basket") {
        change_y -6;
        wait 0.04;
    }
    if playing == 1 {
        if sensing.touchingobject(TOUCHINGOBJECTMENU: "Basket") {
            score += 1;
            play_sound "Pop";
        } else if abs(motion.xposition() - sprites["Basket"].x) < 40 {
            score += 1;
            play_sound "Pop";
        } else {
            misses += 1;
            play_sound "Boing";
        }
    }
    delete_clone;
}

when flag {
    hide;
}
