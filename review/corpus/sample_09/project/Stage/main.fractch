backdrop "Kenney Urban Restaurant" file "assets/bd_0.png" center 240,180;
backdrop "Refrigerator" file "assets/bd_1.svg" center 240,180;
/* 舞台由装配器生成：全局变量 + 背景 + 场景切换 */
var score = 0;
var misses = 0;
var time_left = 10;
var playing = 0;
watch var "score" at 10,10;
watch var "misses" at 10,40;
watch var "time_left" at 10,70;
watch var "playing" at 10,100;

when flag {
    score = 0;
    misses = 0;
    time_left = 10;
    playing = 0;
    backdrop "Kenney Urban Restaurant";
    broadcast scene_intro;
}

when broadcast scene_intro {
    backdrop "Kenney Urban Restaurant";
}

when broadcast scene_play {
    backdrop "Refrigerator";
}

when broadcast scene_end {
    backdrop "Kenney Urban Restaurant";
}

when broadcast game_end {
    stop all;
}
